# Cloudflare Pages response headers.
# Vite fingerprints everything in /assets, so it can be cached forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Only this site and StudySmartly may show the game inside a page (<iframe>).
  Content-Security-Policy: frame-ancestors 'self' https://studysmartly.jn-studios.workers.dev
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/previews/*
  Cache-Control: public, max-age=86400
