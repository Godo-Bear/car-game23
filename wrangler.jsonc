// Cloudflare Workers configuration for Tokyo Circuit Racer.
// `npm run build` produces dist/; `npx wrangler deploy` uploads it as static assets plus the
// small API Worker in server/worker.ts (accounts, saved stats and settings).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "tokyo-circuit-racer",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only API calls run the Worker; every other request is a static file (fast + free).
    "run_worker_first": ["/api/*"]
  },
  // The schema SQL is imported by server/schema.ts and applied automatically on first use.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tokyo-racer",
      "migrations_dir": "migrations"
    }
  ]
}
